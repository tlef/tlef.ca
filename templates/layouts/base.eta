<!DOCTYPE html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
		
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.indigo.min.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.colors.min.css">
		<link rel="stylesheet" href="/style.css">
		<link rel="stylesheet" href="/pico-prism.css">
		<link rel="stylesheet" href="/terminal.css">
		<link rel="stylesheet" href="/profile-pill.css">

		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/theme-toggles@4.10.1/css/classic.min.css">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Figtree&display=swap" rel="stylesheet">
<% /* <link href="https://fonts.googleapis.com/css2?family=Rubik+Glitch&display=swap" rel="stylesheet"> */ %>
		<title><% if (it.title) { %><%~ it.title %><% } else { %>Tim Lefler<% } %></title>
	</head>
	<body class="container">
		<%~ include('../partials/header', it) %>
		<%~ it.body %> 
		<%~ include('../partials/footer', it) %>
		<script src="/theme-toggle.js"></script>
		<script src="/js/terminal.js"></script>
<script src="https://unpkg.com/typify.js@1.1.9/dist/typify.min.js"></script>

		<script>
// Lightweight copy-to-clipboard for server-side highlighted code
// No PrismJS JavaScript needed!

document.addEventListener('DOMContentLoaded', function() {
    addCopyButtons();
});

function addCopyButtons() {
    // Find all pre elements with language classes (server-side highlighted)
    const codeBlocks = document.querySelectorAll('pre[class*="language-"], pre code[class*="language-"]');
    
    codeBlocks.forEach(element => {
        // Get the pre element (whether it's the pre itself or the parent of code)
        const pre = element.tagName === 'PRE' ? element : element.closest('pre');
        
        // Skip if already has a copy button
        if (pre.querySelector('.copy-btn')) return;
        
        // Create and add copy button
        const copyButton = createCopyButton();
        
        // Position the pre relatively so button can be absolute
        pre.style.position = 'relative';
        
        // Add click handler
        copyButton.addEventListener('click', () => copyCode(pre, copyButton));
        
        // Add button to pre
        pre.appendChild(copyButton);
    });
}

function createCopyButton() {
    const button = document.createElement('button');
    button.className = 'copy-btn';
    button.setAttribute('aria-label', 'Copy code to clipboard');
    button.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="m5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
    `;
    return button;
}

async function copyCode(pre, button) {
    const code = pre.innerText;
    try {
        // Modern clipboard API
        await navigator.clipboard.writeText(code);
        showSuccess(button);
    } catch (err) {
        // Fallback for older browsers
        if (fallbackCopy(code)) {
            showSuccess(button);
        } else {
            showError(button);
        }
    }
}

function fallbackCopy(text) {
    try {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.cssText = 'position:fixed;top:-999px;left:-999px;opacity:0;';
        document.body.appendChild(textarea);
        textarea.select();
        const success = document.execCommand('copy');
        document.body.removeChild(textarea);
        return success;
    } catch (err) {
        return false;
    }
}

function showSuccess(button) {
    const originalHTML = button.innerHTML;
    
    // Show checkmark
    button.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20,6 9,17 4,12"></polyline>
        </svg>
    `;

    
    button.classList.add('copy-success');
    
    // Reset after 2 seconds
    setTimeout(() => {
        button.innerHTML = originalHTML;
        button.classList.remove('copy-success');
    }, 2000);
}

function showError(button) {
    const originalHTML = button.innerHTML;
    
    // Show error X
    button.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    `;
    
    button.classList.add('copy-error');
    
    // Reset after 2 seconds
    setTimeout(() => {
        button.innerHTML = originalHTML;
        button.classList.remove('copy-error');
    }, 2000);
}		</script>


    <script>
        const input = document.querySelector('.terminal-input');
        const cursor = document.getElementById('cursor');

        function updateCursorPosition() {
            const cursorPosition = input.selectionStart;
            
            // Get text up to cursor position
            const textBeforeCursor = input.value.substring(0, cursorPosition);
            
            // Create a temporary span to measure text width
            const temp = document.createElement('span');
            temp.style.visibility = 'hidden';
            temp.style.position = 'absolute';
            temp.style.font = window.getComputedStyle(input).font;
            temp.style.whiteSpace = 'pre'; // Preserve spaces
            temp.textContent = textBeforeCursor;
            document.body.appendChild(temp);
            
            const textWidth = temp.offsetWidth;
            cursor.style.left = textWidth + 'px';
            
            document.body.removeChild(temp);
        }

        // Update cursor position on various events
        input.addEventListener('input', updateCursorPosition);
        input.addEventListener('keyup', updateCursorPosition);
        input.addEventListener('keydown', updateCursorPosition);
        input.addEventListener('click', updateCursorPosition);
        input.addEventListener('focus', updateCursorPosition);
        input.addEventListener('blur', updateCursorPosition);
        
        // Handle selection changes (like when using Shift+Arrow keys)
        input.addEventListener('selectionchange', updateCursorPosition);

        // Focus the input when clicking anywhere in the terminal
        document.querySelector('.terminal-container').addEventListener('click', () => {
            input.focus();
        });

        // Initial cursor position
        updateCursorPosition();
    </script>
	</body>
</html>
