<% layout('layouts/base') %>

<article class="post">
  <header class="post-header">
    <h1><%= it.title || it.slug %></h1>
    <div class="post-meta">
      <% if (it.date) { %><time datetime="<%= it.date %>"><%= new Date(it.date).toLocaleDateString() %></time><% } %>
      <% if (it.author) { %> • By <%= it.author %><% } %>
      <% if (it.readingTime) { %> • <%= it.readingTime %> min read<% } %>
    </div>
    <% if (it.tags && (Array.isArray(it.tags) ? it.tags : it.tags.split(',')).length) { %>
      <div class="post-tags">
        <% (Array.isArray(it.tags) ? it.tags : it.tags.split(',')).forEach(function(tag) { %>
          <span><%= tag.trim() %></span>
        <% }) %>
      </div>
    <% } %>
  </header>
  
  <div class="post-content">
    <%~ it.content %>
  </div>
  
  <footer class="post-footer">
    <p><a href="/posts" data-spa-link>← Back to all posts</a></p>
  </footer>
</article>
