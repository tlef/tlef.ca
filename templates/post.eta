<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.title || it.slug %> - tlef.ca</title>
</head>
<body>
  <nav>
    <a href="/" data-spa-link>Home</a>
    <a href="/posts" data-spa-link>Blog</a>
  </nav>
  
  <main id="main-content">
    <article class="post" id="post-content">
      <h1><%= it.title %></h1>
      <% if (it.date) { %><p class="date"><%= new Date(it.date).toLocaleDateString() %></p><% } %>
      <% if (it.author) { %><p class="author">By <%= it.author %></p><% } %>
      <% if (it.tags) { %><p class="tags">Tags: <%= Array.isArray(it.tags) ? it.tags.join(', ') : it.tags %></p><% } %>
      <div class="content">
        <%~ it.content %>
      </div>
    </article>
  </main>

  <script>
    // SPA Navigation Logic
    document.addEventListener('click', function (e) {
      const link = e.target.closest('a[data-spa-link]');
      if (link) {
        e.preventDefault();
        const url = link.getAttribute('href');
        loadPage(url);
      }
    });

    window.addEventListener('popstate', function () {
      loadPage(location.pathname);
    });

    function loadPage(url) {
      // For post pages, fetch JSON data and render
      if (url.startsWith('/posts/') && url !== '/posts') {
        fetch(`/api${url}`)
        .then(res => {
          if (!res.ok) {
            throw new Error(`HTTP ${res.status}: ${res.statusText}`);
          }
          return res.json();
        })
        .then(data => {
          const postContent = document.getElementById('post-content');
          const formattedDate = data.date ? new Date(data.date).toLocaleDateString() : '';
          const tagsArray = Array.isArray(data.tags) ? data.tags : (data.tags ? data.tags.split(',').map(t => t.trim()) : []);
          
          postContent.innerHTML = `
            <h1>${data.title || data.slug}</h1>
            ${formattedDate ? `<p class="date">${formattedDate}</p>` : ''}
            ${data.author ? `<p class="author">By ${data.author}</p>` : ''}
            ${tagsArray.length ? `<p class="tags">Tags: ${tagsArray.join(', ')}</p>` : ''}
            <div class="content">${data.content}</div>
          `;
          document.title = `${data.title || data.slug} - tlef.ca`;
          window.history.pushState({}, '', url);
        })
        .catch(err => {
          console.error('Failed to load post:', err);
          window.location.href = url; // Fallback to full page load
        });
      } else {
        // For other pages, do a full page load for now
        window.location.href = url;
      }
    }
  </script>
</body>
</html>
