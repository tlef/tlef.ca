<% layout('layouts/base') %>

<section>
  <div class="blog-container">
    <main>
			<div class="heading">
				<h1><%= it.post.title || it.post.slug %></h1>
				<hr />
				<% if (it.post.author || it.post.date) { %>
					<div style="display: flex; justify-content: space-between; align-items: baseline;">
						<% if (it.post.author) { %>
							<div><%= it.post.author %> • <%= it.post.minsToRead %> min<% if (it.post.minsToRead !== 1) { %>s<% } %></div> 
						<% } %>
						<% if (it.post.date) { %>
							<div>
								<time datetime="<%= it.post.date.toISOString() %>">
									<%= new Date(it.post.date).toLocaleDateString(it.locale, { 
										year: 'numeric', 
										month: 'short', 
										day: 'numeric' 
									}) %>
								</time>
							</div>
						<% } %>
					</div>
				<% } %>
				<% /* <% if (Array.isArray(it.post.tags) && it.post.tags.length) { %>
					<div class="tags">
						<% it.post.tags.forEach(function(tag) { %>
							<a href="/category/<%= tag %>"><%= tag %></a>
						<% }) %>
					</div>
				<% } %> */ %>
			<% if (it.post.note) { %>
				<div class="blog-note">
					<p><%~ it.post.note %></p>
				</div>
			<% } %>
			</div>
			<%~ it.post.content %>
		</main>
		<% if (it.post.author && it.post.author === 'tlef') { %>
			<section style="margin-top: 5rem;">
				<hr>
				<div class="grid" style="grid-template-columns: 1fr 3fr;">
					<img src="/avatar.jpg" alt="Tim Lefler's Avatar" class="author-avatar">
					<div>
						<h4>Written by Tim Lefler</h4>

						Dolor, exercitation et esse lorem tempor ullamco sed. Esse lorem tempor ullamco sed veniam, sunt. Ullamco sed veniam, sunt ullamco do duis. Sunt ullamco do duis magna. Do duis magna et laborum lorem adipiscing consequat.<br><br>

						<a href="/about">Learn more</a>
					</div>
				</div>
			</section>
		<% } %>
  </div>
</section>