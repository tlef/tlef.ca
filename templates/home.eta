<% layout('layouts/base') %>

<section class="home-container">
  <main>
		<section class="hero grid" style="grid-template-columns: 8fr 6fr;">
			<div>
				<h1>Hello, my name is Tim and I build things on the internet.</h1>
				<% /* <div class="profile-pill" style="margin-top: 5rem;">
						<div class="profile-pill-avatar">
								<img src="avatar.jpg" alt="Profile">
						</div>
						<div class="profile-pill-info">
							<div class="profile-pill-name">Tim Lefler</div>
							<div class="profile-pill-status">Software Developer</div>
						</div>
				</div> */ %>
			</div>
			<div id="terminal"></div>
		</section>

    <div class="terminal-overlay-backdrop" id="terminal-backdrop"></div>
		<h1>Latest Posts</h1>
		<div class="grid">
			<div>
				<% if (it.posts && it.posts.length > 0) { %>
					<% it.posts.forEach(function(post) { %>
					<article>
						<h4><a href="/posts/<%= post.slug %>"><%= post.title %></a></h4>
						<p><%= post.summary %></p>
					</article>
				<% }) %>
					<div>
						<a href="/posts?offset=<%= it.posts.length %>">Read more...</a>
					</div>
				<% } else { %>
						<p>No posts found.</p>
				<% } %>
			</div>
			<div class="sidebar hide-on-mobile">
				<form action="/posts" method="get">
					<div class="search-input-group">
						<input type="text" name="search" placeholder="Search posts..." required>
						<button type="submit">
							<%~ it.icons['search'] || 'Search' %>
						</button>
					</div>
				</form>
				<h3>Categories</h3>
				<div class="category-list">
					<ul>
						<% it.categories.forEach(function(category) { %>
							<li><a href="/posts?search=<%= category.tag %>"><%= category.title %></a></li>
						<% }) %>
					</ul>
				</div>
				<h3>Popular Posts</h3>
				<div class="category-list">
					<ul>
						<% it.popularPosts.forEach(function(post) { %>
							<li><a href="/posts/<%= post.slug %>"><%= post.title %></a></li>
						<% }) %>
					</ul>
				</div>
			</div>
		</div>
	</main>
</section>
