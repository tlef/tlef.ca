<% layout('layouts/base') %>

<div class="content-container">
  <section class="intro-section">
    <h1 class="intro-title">Articles and Tutorials</h1>
    <p class="intro-text">
      Deep dives into software development, web technologies, and the craft of building great software.
    </p>
  </section>

  <section class="content-section">
    <% if (it.posts && it.posts.length) { %>
      <div class="articles-grid">
        <% it.posts.forEach(function(post) { %>
          <article class="article-card">
            <h2 class="article-title">
              <a href="/posts/<%= post.slug %>" data-spa-link><%= post.title || post.slug %></a>
            </h2>
            <div class="article-meta">
              <% if (post.date) { %><time datetime="<%= post.date %>"><%= new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></time><% } %>
              <% if (post.author) { %> • By <%= post.author %><% } %>
              <% if (post.readingTime) { %> • <%= post.readingTime %> min read<% } %>
            </div>
            <% if (post.summary) { %>
              <div class="article-summary"><%= post.summary %></div>
            <% } %>
            <% if (post.tags) { %>
              <% let tagsArray = Array.isArray(post.tags) ? post.tags : post.tags.split(','); %>
              <% if (tagsArray.length > 0) { %>
                <div class="article-tags">
                  <% tagsArray.forEach(function(tag) { %>
                    <a href="/posts?tag=<%= encodeURIComponent(tag.trim()) %>" class="article-tag" data-spa-link><%= tag.trim() %></a>
                  <% }) %>
                </div>
              <% } %>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 3rem 0;">
        <p style="color: var(--muted-text); font-size: 1.125rem;">No articles available yet.</p>
        <p><a href="/" data-spa-link>← Back to home</a></p>
      </div>
    <% } %>
  </section>
</div>
