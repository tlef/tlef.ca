<% layout('layouts/base') %>

<section>
	<div>
		<form action="/posts" method="get">
			<div class="search-input-group" style="max-width: 40rem; margin-left: auto; margin-right: auto;margin-bottom: 2rem;">
				<input type="text" name="search" placeholder="Search posts..." required value="<%= it.query || '' %>">
				<button type="submit">
					<%~ it.icons['search'] || 'Search' %>
				</button>
			</div>
		</form>
		<% if (it.query) { %>
		<main style="max-width: 40rem; margin-left: auto; margin-right: auto;margin-bottom: 2rem;">
		<% }else{%>
		<main class="grid" style="grid-template-columns: 2fr 1fr;">
		<% } %>
			<div>
		<% if (!it.posts || it.posts.length === 0) { %>
			<% if (it.query) { %>
				<p>No results for "<%= it.query %>".</p>
			<% } else { %>
				<p>No results.</p>
			<% } %>
		<% } else { %>
			<% it.posts.forEach(function(post) { %>
				<article>
					<h3><a href="/posts/<%= post.slug %>"><%= post.title %></a></h3>
					<p><%= post.summary %></p>
					<% if (Array.isArray(post.tags)) { %>
						<div class="tags">
							<% post.tags.forEach(function(tag) { %>
								<a href="/posts?tag=<%= tag %>"><%= tag %></a>
							<% }) %>
						</div>
					<% } %>
				</article>	
			<% }) %>
		<% } %>
		<% if (it.pagination && (it.pagination.totalPages > 1)) { %>
			<nav class="pagination" aria-label="Posts pagination">
				<% if (it.pagination.hasPrev) { %>
					<a href="/posts?page=<%= it.pagination.prevPage %><%= it.query ? '&search=' + encodeURIComponent(it.query) : '' %>" aria-label="Previous page">« Previous</a>
				<% } %>
				
				<span class="page-info">
					Page <%= it.pagination.currentPage %> of <%= it.pagination.totalPages %>
				</span>
				
				<% if (it.pagination.hasNext) { %>
					<a href="/posts?page=<%= it.pagination.nextPage %><%= it.query ? '&search=' + encodeURIComponent(it.query) : '' %>" aria-label="Next page">Next »</a>
				<% } %>
			</nav>
		<% } %>
		</div>

		<% if (!it.query) { %>
			<div>				
				<h3>Categories</h3>
				<div class="category-list">
					<ul>
						<% it.categories.forEach(function(category) { %>
							<li><a href="/posts?tag=<%= encodeURIComponent(category.tag) %>"><%= category.title %></a></li>
						<% }) %>
					</ul>
				</div>
				<h3>Popular Posts</h3>
				<div class="category-list">
					<ul>
						<% it.popularPosts.forEach(function(post) { %>
							<li><a href="/posts/<%= post.slug %>"><%= post.title %></a></li>
						<% }) %>
					</ul>
				</div>
			</div>
		<% } %>
		</main>
	</div>
</section>
